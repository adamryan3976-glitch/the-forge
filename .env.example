# Copy this file to .env for local development and fill in the values from
# Firebase Console > Project settings > General > Your apps > SDK setup.
# For the published site, add these same six values as GitHub repository
# secrets instead (see README.md). They are not passwords: Firebase expects
# them to be public; firestore.rules is what protects the data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
